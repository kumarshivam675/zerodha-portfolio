# Copy to .env and fill in. Never commit .env.

# Host port for the web app. If you change it, also change WEB_URL and the
# Kite redirect URL to match.
WEB_PORT=3300
WEB_URL=http://localhost:3300

# Zerodha Kite Connect app (https://developers.kite.trade). Set the app's
# Redirect URL to: http://localhost:3300/api/kite/callback
KITE_API_KEY=
KITE_API_SECRET=

# Anthropic API key for the AI agent and daily brief
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high

# Daily job: crontab "min hour dom mon dow", in TIMEZONE (default 16:30 IST on weekdays)
DAILY_JOB_CRON=30 16 * * mon-fri
TIMEZONE=Asia/Kolkata
AUTO_SNAPSHOT=true
AUTO_BRIEF=true

# Slack notifications for finished analyses and daily briefs (leave empty to disable).
# Create an Incoming Webhook: https://api.slack.com/apps -> Create app -> Incoming Webhooks
SLACK_WEBHOOK_URL=
SLACK_NOTIFY_ANALYSES=true   # Analyse runs from the holdings table
SLACK_NOTIFY_CHAT=true       # answers to Analyst-page questions and follow-ups
SLACK_NOTIFY_BRIEFS=true
# Long reports are condensed into a crisp digest by this model (full report stays in the app).
SLACK_DIGEST_MODEL=claude-sonnet-5-5
# Mask your own figures (quantities, values, P&L) in Slack; market data stays visible.
SLACK_HIDE_AMOUNTS=true

# Postgres (only read when the volume is first created)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio
AGENT_DB_PASSWORD=change-me-too

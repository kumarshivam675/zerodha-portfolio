# Copy to .env and fill in. Never commit .env.

# Host port for the web app. If you change it, also change WEB_URL and the
# Kite redirect URL to match.
WEB_PORT=3300
WEB_URL=http://localhost:3300

# Zerodha Kite Connect app (https://developers.kite.trade). Set the app's
# Redirect URL to: http://localhost:3300/api/kite/callback
KITE_API_KEY=
KITE_API_SECRET=

# Anthropic API key for the AI agent and daily brief
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high

# Daily job: crontab "min hour dom mon dow", in TIMEZONE (default 16:30 IST on weekdays)
DAILY_JOB_CRON=30 16 * * mon-fri
TIMEZONE=Asia/Kolkata
AUTO_SNAPSHOT=true
AUTO_BRIEF=true

# Postgres (only read when the volume is first created)
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio
AGENT_DB_PASSWORD=change-me-too
